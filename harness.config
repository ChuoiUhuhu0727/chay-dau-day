# Cấu hình dự án mà harness đang build. Đổi file này để harness build loại app khác — KHÔNG sửa script.
#
#   STACK=web      → game HTML/JS trong game/  (mặc định, chạy được ngay với Node + Chrome)
#   STACK=android  → app/game Android (Kotlin + Gradle) trong APP_DIR, test bằng JUnit, chạy thử trên emulator

STACK=web
APP_DIR=game

# --- Chỉ dùng khi STACK=android ---------------------------------------------------------
# Tạo project trước bằng Android Studio (New Project → Empty Activity) vào thư mục APP_DIR,
# rồi harness build từng tính năng trên đó.
# APP_DIR=android-game
ANDROID_UNIT_TEST="testDebugUnitTest"      # task Gradle chạy unit test
ANDROID_BUILD="assembleDebug"              # task Gradle build APK
ANDROID_APK="app/build/outputs/apk/debug/app-debug.apk"
ANDROID_PACKAGE=""                         # ví dụ: com.example.parkingjam (để chạy thử trên emulator)
